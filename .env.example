NODE_ENV=development
PORT=5002

# Frontend origin. Use the exact deployed frontend URL in production.
# For multiple origins, separate with commas.
CLIENT_URL=http://localhost:3000

# MongoDB Atlas or local MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/amp_tiles

# JWT signing secret. Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Email sending via Brevo.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AMP Tiles
SMTP_REPLY_TO=

# Optional quotation response notification email.
QUOTATION_RESPONSE_NOTIFY_EMAIL=

# Optional PDF/logo/Puppeteer settings.
PDF_LOGO_PATH=./AMP-TILES-LOGO.png
PUPPETEER_CACHE_DIR=.cache/puppeteer
PUPPETEER_EXECUTABLE_PATH=
CHROME_PATH=

# Optional CORS setting for Vercel preview deployments.
ALLOW_VERCEL_PREVIEWS=false

# Purchase order behavior.
AUTO_STOCK_ON_PO_RECEIVE=true

# Optional admin seed values used by npm run seed:admin.
ADMIN_SEED_NAME=Admin User
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=
